<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.dynamisengine</groupId>
        <artifactId>nnjava-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>nnjava-backend-vectrix-gpu</artifactId>
    <properties>
        <nn.gpu.backend>none</nn.gpu.backend>
        <nn.native.args></nn.native.args>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>nnjava-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>vectrix-core</artifactId>
            <version>${vectrix.version}</version>
            <classifier>${vectrix.classifier}</classifier>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>vectrix-ml</artifactId>
            <version>${vectrix.version}</version>
            <classifier>${vectrix.classifier}</classifier>
            <exclusions>
                <exclusion>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>vectrix-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>vectrix-ml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>vectrix-gpu</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>vectrix-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>vectrix-ml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>dynamis-gpu-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>dynamis-gpu-primitives</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>vectrix-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>vectrix-ml</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>nnjava-backend-vectrix</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.dynamisengine</groupId>
            <artifactId>nnjava-nn</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>${nn.jvm.args} ${nn.native.args}</argLine>
                    <systemPropertyVariables>
                        <nn.gpu.backend>${nn.gpu.backend}</nn.gpu.backend>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>metal</id>
            <properties>
                <nn.gpu.backend>METAL</nn.gpu.backend>
                <nn.native.args>--enable-native-access=ALL-UNNAMED</nn.native.args>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>dynamis-gpu-metal</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>vulkan</id>
            <properties>
                <nn.gpu.backend>VULKAN</nn.gpu.backend>
                <nn.native.args>--enable-native-access=ALL-UNNAMED</nn.native.args>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>org.dynamisengine</groupId>
                    <artifactId>dynamis-gpu-vulkan</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
